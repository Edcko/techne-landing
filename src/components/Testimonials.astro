---
const testimonials = [
  {
    quote: "The attention to detail and technical expertise exceeded our expectations. They didn't just build what we asked — they built what we actually needed.",
    author: "Client",
    role: "Tools Automotriz",
    accent: '#E8963E',
  },
  {
    quote: "Fast, reliable, and always available. The fact that the team operates around the clock with AI-assisted development means things move incredibly fast.",
    author: "Client",
    role: "Public Security",
    accent: '#B8C4D8',
  },
];
---

<section id="testimonials" data-animate class="py-32 px-6 relative">
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-4xl">
    <div class="line-glow opacity-20"></div>
  </div>

  <div class="max-w-4xl mx-auto">
    <!-- Section header -->
    <div class="text-center mb-20" data-reveal>
      <span class="text-xs tracking-[0.3em] text-eclipse/60 font-body uppercase mb-4 block">Testimonials</span>
      <h2 class="font-heading text-4xl sm:text-5xl font-bold tracking-tight mb-6">
        What clients say
      </h2>
      <div class="w-16 h-px bg-gradient-to-r from-apollo to-artemis mx-auto"></div>
    </div>

    <!-- Testimonials -->
    <div class="space-y-8">
      {testimonials.map((t, i) => (
        <div
          data-reveal
          class="relative p-8 sm:p-10 rounded-2xl bg-carbon/30 border border-shadow/40 hover:border-shadow transition-all duration-300"
        >
          <!-- Quote mark -->
          <svg class="absolute top-6 right-8 opacity-10" width="48" height="48" viewBox="0 0 24 24" fill={t.accent}>
            <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
          </svg>

          <blockquote class="text-marble/80 text-lg sm:text-xl leading-relaxed font-body italic mb-8 relative z-10">
            "{t.quote}"
          </blockquote>

          <div class="flex items-center gap-4">
            <div class="w-10 h-10 rounded-full flex items-center justify-center" style={`background: ${t.accent}15; border: 1px solid ${t.accent}30;`}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke={t.accent} stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
              </svg>
            </div>
            <div>
              <p class="font-heading text-sm font-semibold text-marble">{t.author}</p>
              <p class="text-xs font-body" style={`color: ${t.accent};`}>{t.role}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
