---
import SectionHeader from './SectionHeader.astro';

const team = [
  { nameKey: 'about.edname', roleKey: 'about.edrole', descKey: 'about.eddesc', emoji: false, icon: 'user' },
  { nameKey: 'about.artname', roleKey: 'about.artrole', descKey: 'about.artdesc', emoji: '🌙' },
  { nameKey: 'about.aplname', roleKey: 'about.aplrole', descKey: 'about.apldesc', emoji: '☀️' },
];
---

<section id="about" data-animate class="py-32 px-6 relative" data-theme-bg>
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-4xl"><div class="line-glow opacity-20"></div></div>
  <div class="max-w-6xl mx-auto">
    <SectionHeader label="Who we are" title="About Techne" labelI18n="about.label" titleI18n="about.title" />
    <div class="max-w-3xl mx-auto text-center mb-20" data-reveal>
      <p class="text-lg leading-relaxed font-body mb-8" data-theme-muted>
        <span class="font-heading font-semibold text-2xl text-gradient-gold">Τέχνη</span>
        <span data-i18n="about.p1"></span>
      </p>
      <p class="leading-relaxed font-body" data-theme-muted data-i18n="about.p2"></p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-4xl mx-auto">
      {team.map((member) => (
        <div data-reveal class="group text-center p-8 rounded-2xl transition-all duration-300" data-theme-card>
          <div class="w-16 h-16 rounded-2xl flex items-center justify-center mx-auto mb-5 data-theme-card">
            {member.icon === 'user' ? (
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-apollo">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
              </svg>
            ) : (
              <span class="text-2xl">{member.emoji}</span>
            )}
          </div>
          <h3 class="font-heading text-lg font-semibold mb-1" data-theme-text data-i18n={member.nameKey}></h3>
          <p class="text-xs tracking-widest uppercase mb-3 font-body text-apollo" data-i18n={member.roleKey}></p>
          <p class="text-sm font-body leading-relaxed" data-theme-muted data-i18n={member.descKey}></p>
        </div>
      ))}
    </div>
  </div>
</section>
