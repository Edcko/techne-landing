---
const services = [
  {
    title: 'Web Development',
    description: 'Modern, responsive web applications built with cutting-edge frameworks. From landing pages to complex SaaS platforms.',
    color: '#E8963E',
    bgColor: 'rgba(232,150,62,0.1)',
    borderColor: 'rgba(232,150,62,0.2)',
  },
  {
    title: 'Mobile Apps',
    description: 'Cross-platform mobile experiences that feel native. Flutter, React Native, and beyond — your app, everywhere.',
    color: '#B8C4D8',
    bgColor: 'rgba(184,196,216,0.1)',
    borderColor: 'rgba(184,196,216,0.2)',
  },
  {
    title: 'Automation',
    description: 'Intelligent workflows that save time and eliminate errors. APIs, bots, and custom integrations tailored to your process.',
    color: '#C49A5A',
    bgColor: 'rgba(196,154,90,0.1)',
    borderColor: 'rgba(196,154,90,0.2)',
  },
  {
    title: 'SaaS Solutions',
    description: 'End-to-end SaaS products designed for scale. Architecture, development, deployment, and ongoing support.',
    color: '#F0A84C',
    bgColor: 'rgba(240,168,76,0.1)',
    borderColor: 'rgba(240,168,76,0.2)',
  },
];

const icons = [
  // Globe
  '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>',
  // Smartphone
  '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>',
  // Zap
  '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>',
  // Layers
  '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>',
];
---

<section id="services" data-animate class="py-32 px-6">
  <div class="max-w-6xl mx-auto">
    <!-- Section header -->
    <div class="text-center mb-20" data-reveal>
      <span class="text-xs tracking-[0.3em] text-eclipse/60 font-body uppercase mb-4 block">What we do</span>
      <h2 class="font-heading text-4xl sm:text-5xl font-bold tracking-tight mb-6">
        Services
      </h2>
      <div class="w-16 h-px bg-gradient-to-r from-apollo to-artemis mx-auto"></div>
    </div>

    <!-- Services grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {services.map((service, i) => (
        <div
          data-reveal
          class="group relative p-8 rounded-2xl bg-carbon/50 border border-shadow/50 hover:border-shadow transition-all duration-300 cursor-default overflow-hidden"
        >
          <!-- Hover glow -->
          <div class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"
            style={`background: radial-gradient(circle at 50% 0%, ${service.color} 0%, transparent 70%); opacity: 0;`}
          ></div>

          <div class="relative z-10">
            <!-- Icon -->
            <div class="w-12 h-12 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300"
              style={`background: ${service.bgColor}; border: 1px solid ${service.borderColor}; color: ${service.color};`}
              set:html={icons[i]}
            >
            </div>

            <h3 class="font-heading text-xl font-semibold mb-3 text-marble">
              {service.title}
            </h3>
            <p class="text-artemis/50 text-sm leading-relaxed font-body">
              {service.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
