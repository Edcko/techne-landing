---
import SectionHeader from './SectionHeader.astro';

const services = [
  { color: '#E8963E',
    icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>' },
  { color: '#B8C4D8',
    icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>' },
  { color: '#C49A5A',
    icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>' },
  { color: '#F0A84C',
    icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>' },
];
---

<section id="services" data-animate class="py-32 px-6" data-theme-bg>
  <div class="max-w-6xl mx-auto">
    <SectionHeader label="What we do" title="Services" labelI18n="services.label" titleI18n="services.title" />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {services.map((service, i) => (
        <div data-reveal class="group relative p-8 rounded-2xl overflow-hidden transition-all duration-300 cursor-default" data-theme-card>
          <div class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"
            style={`background: radial-gradient(circle at 50% 0%, ${service.color} 0%, transparent 70%); opacity: 0;`}></div>
          <div class="relative z-10">
            <div class="w-12 h-12 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300 data-theme-card"
              style={`color: ${service.color};`}
              set:html={service.icon}></div>
            <h3 class="font-heading text-xl font-semibold mb-3" data-theme-text data-i18n={`services.s${i+1}title`}></h3>
            <p class="text-sm leading-relaxed font-body" data-theme-muted data-i18n={`services.s${i+1}desc`}></p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
