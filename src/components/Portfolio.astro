---
const projects = [
  { url: 'https://toolsautomotriz.com', accent: '#E8963E', stack: ['Django', 'PostgreSQL', 'Gunicorn', 'REST API'] },
  { url: 'https://publicsecurity.techne.ascencia.com', accent: '#B8C4D8', stack: ['Next.js', 'Drizzle ORM', 'PostgreSQL', 'Real-time'] },
];
---

<section id="portfolio" data-animate class="py-32 px-6 relative" data-theme-bg>
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-4xl"><div class="line-glow opacity-20"></div></div>
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-20" data-reveal>
      <span class="text-xs tracking-[0.3em] uppercase mb-4 block font-body" data-theme-label data-i18n="portfolio.label">Our work</span>
      <h2 class="font-heading text-4xl sm:text-5xl font-bold tracking-tight mb-6" data-theme-text data-i18n="portfolio.title">Featured Projects</h2>
      <div class="w-16 h-px bg-gradient-to-r from-apollo to-artemis mx-auto mb-6"></div>
      <p class="text-lg font-body max-w-xl mx-auto" data-theme-muted data-i18n="portfolio.subtitle">Real products, real impact. Here are some of the projects we've brought to life.</p>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      {projects.map((project, i) => (
        <div data-reveal class="group relative rounded-2xl overflow-hidden transition-all duration-500" data-theme-card>
          <div class="h-1 w-full" style={`background: linear-gradient(90deg, ${project.accent}, transparent);`}></div>
          <div class="p-8">
            <div class="flex items-start gap-4 mb-6">
              <div class="w-12 h-12 rounded-xl flex items-center justify-center shrink-0 data-theme-card">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke={project.accent} stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
                </svg>
              </div>
              <div>
                <h3 class="font-heading text-xl font-semibold group-hover:text-white transition-colors" data-theme-text data-i18n={`portfolio.p${i+1}title`}></h3>
                <a href={project.url} target="_blank" rel="noopener noreferrer"
                  class="text-xs tracking-wider font-body cursor-pointer hover:opacity-80 transition-opacity text-apollo">
                  {project.url.replace('https://', '').replace('http://', '')} ↗
                </a>
              </div>
            </div>
            <p class="text-sm leading-relaxed font-body mb-6" data-theme-muted data-i18n={`portfolio.p${i+1}desc`}></p>
            <div class="flex flex-wrap gap-2">
              {project.stack.map((tech) => (
                <span class="px-3 py-1 rounded-lg text-xs font-mono font-medium text-apollo border border-apollo/20 bg-apollo/5">{tech}</span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
    <div class="text-center mt-16" data-reveal>
      <p class="text-sm font-body mb-4" data-theme-muted data-i18n="portfolio.cta">Want to see your project here?</p>
      <a href="#contact" class="inline-flex items-center gap-2 text-sm font-medium cursor-pointer transition-colors duration-200 data-theme-label">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
        </svg>
        <span data-i18n="portfolio.ctalink">Let's talk about it</span>
      </a>
    </div>
  </div>
</section>
