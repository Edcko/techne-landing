---
interface Props {
  id: string;
  extraClasses?: string;
}

const { id, extraClasses = "" } = Astro.props;
const sunId = id === "theme-toggle-mobile" ? "icon-sun-m" : "icon-sun";
const moonId = id === "theme-toggle-mobile" ? "icon-moon-m" : "icon-moon";
const sunClass = id === "theme-toggle-mobile" ? "icon-sun-m w-5 h-5 hidden" : "w-5 h-5 hidden";
const moonClass = id === "theme-toggle-mobile" ? "icon-moon-m w-5 h-5" : "w-5 h-5";
---

<button
  id={id}
  class={`p-2 rounded-lg cursor-pointer transition-colors duration-200 hover:bg-carbon/30 ${extraClasses}`}
  aria-label="Toggle theme"
>
  <svg id={sunId} class={sunClass} viewBox="0 0 24 24" fill="none" stroke="#E8963E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
  </svg>
  <svg id={moonId} class={moonClass} viewBox="0 0 24 24" fill="none" stroke="#B8C4D8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
  </svg>
</button>
