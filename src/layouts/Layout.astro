---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0B0D17" />
    <meta name="description" content="Techne builds modern web applications, mobile apps, and intelligent automations. Masterful craft. Infinite solutions." />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Techne" />
    <link rel="canonical" href="https://techne.ascencia.com/techne/" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://techne.ascencia.com/techne/" />
    <meta property="og:title" content="Techne — Software Development Studio" />
    <meta property="og:description" content="Techne builds modern web applications, mobile apps, and intelligent automations." />
    <meta property="og:image" content="https://techne.ascencia.com/techne/og-image.svg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Techne" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Techne — Software Development Studio" />
    <meta name="twitter:description" content="Techne builds modern web applications, mobile apps, and intelligent automations." />
    <meta http-equiv="Content-Security-Policy" content="script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'" />
    <link rel="alternate" hreflang="en" href="https://techne.ascencia.com/techne/" />
    <link rel="alternate" hreflang="es" href="https://techne.ascencia.com/techne/" />
    <link rel="icon" type="image/svg+xml" href="/techne/favicon.svg" />
    <link rel="stylesheet" href="/techne/fonts/fonts.css" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "name": "Techne",
          "url": "https://techne.ascencia.com/techne/",
          "logo": "https://techne.ascencia.com/techne/favicon.svg"
        },
        {
          "@type": "WebSite",
          "url": "https://techne.ascencia.com/techne/"
        },
        {
          "@type": "ProfessionalService",
          "name": "Techne",
          "url": "https://techne.ascencia.com/techne/",
          "logo": "https://techne.ascencia.com/techne/favicon.svg",
          "hasOfferCatalog": {
            "@type": "OfferCatalog",
            "name": "Services",
            "itemListElement": [
              {
                "@type": "Offer",
                "itemOffered": {
                  "@type": "Service",
                  "name": "Web Development",
                  "description": "Modern, responsive web applications built with cutting-edge technologies."
                }
              },
              {
                "@type": "Offer",
                "itemOffered": {
                  "@type": "Service",
                  "name": "Mobile Development",
                  "description": "Native and cross-platform mobile applications for iOS and Android."
                }
              },
              {
                "@type": "Offer",
                "itemOffered": {
                  "@type": "Service",
                  "name": "AI & Automation",
                  "description": "Intelligent automations and AI-powered solutions to streamline your business."
                }
              },
              {
                "@type": "Offer",
                "itemOffered": {
                  "@type": "Service",
                  "name": "Cloud Solutions",
                  "description": "Scalable cloud infrastructure and DevOps solutions for modern enterprises."
                }
              }
            ]
          }
        }
      ]
    })} />
  </head>
  <body class="min-h-screen font-body antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:z-[100] focus:p-4 focus:bg-apollo focus:text-obsidian">Skip to content</a>
    <Navbar />
    <main id="main"><slot /></main>
    <Footer />

    <script>
      const { translations: T } = await import('../i18n/translations.ts');

      let lang = (localStorage.getItem('techne-lang') as 'en' | 'es') || 'en';
      let theme = (localStorage.getItem('techne-theme') as 'dark' | 'light') || 'dark';

      function applyTheme(t: string) {
        document.body.classList.toggle('light', t === 'light');
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', t === 'light' ? '#F8F7F4' : '#0B0D17');
        document.querySelectorAll('#icon-sun, .icon-sun-m').forEach(el => el.classList.toggle('hidden', t !== 'light'));
        document.querySelectorAll('#icon-moon, .icon-moon-m').forEach(el => el.classList.toggle('hidden', t !== 'dark'));
      }

      function applyLang(l: string) {
        const dict = T[l] || T.en;
        document.querySelectorAll('[data-i18n]').forEach(el => {
          const key = el.getAttribute('data-i18n');
          if (key && dict[key]) el.textContent = dict[key];
        });
        document.querySelectorAll('[data-i18n-placeholder]').forEach(el => {
          const key = el.getAttribute('data-i18n-placeholder');
          if (key && dict[key]) (el as HTMLInputElement).placeholder = dict[key];
        });
        document.documentElement.lang = l;
        const label = l === 'en' ? 'ES' : 'EN';
        document.querySelectorAll('#lang-label, .lang-label-m').forEach(el => el.textContent = label);
      }

      applyTheme(theme);
      applyLang(lang);

      document.querySelectorAll('#theme-toggle, #theme-toggle-mobile').forEach(el => {
        el.addEventListener('click', () => {
          theme = theme === 'dark' ? 'light' : 'dark';
          localStorage.setItem('techne-theme', theme);
          applyTheme(theme);
        });
      });

      const toggleLang = () => {
        lang = lang === 'en' ? 'es' : 'en';
        localStorage.setItem('techne-lang', lang);
        applyLang(lang);
      };
      document.querySelectorAll('#lang-toggle, #lang-toggle-mobile').forEach(el => {
        el.addEventListener('click', toggleLang);
      });

      const prefersReducedMotion = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (prefersReducedMotion) {
        const { default: Lenis } = await import('lenis');
        const lenis = new Lenis({ duration: 1.2, easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)), smoothWheel: true });
        (function raf(time: number) { lenis.raf(time); requestAnimationFrame(raf); })(performance.now());

        const { gsap } = await import('gsap');
        const { ScrollTrigger } = await import('gsap/ScrollTrigger');
        gsap.registerPlugin(ScrollTrigger);

        document.querySelectorAll('[data-animate]').forEach((section) => {
          const children = section.querySelectorAll('[data-reveal]');
          gsap.fromTo(children, { opacity: 0, y: 40 }, {
            opacity: 1, y: 0, duration: 0.8, stagger: 0.15, ease: 'power3.out',
            scrollTrigger: { trigger: section, start: 'top 80%', toggleActions: 'play none none none' },
          });
        });

        const heroEclipse = document.querySelector('#hero-eclipse');
        if (heroEclipse) {
          gsap.to(heroEclipse, { y: 80, scale: 1.05, opacity: 0.6,
            scrollTrigger: { trigger: '#hero', start: 'top top', end: 'bottom top', scrub: 1 },
          });
        }

        document.querySelectorAll('.constellation-node').forEach((node) => {
          gsap.to(node, {
            opacity: 0.3 + Math.random() * 0.5, scale: 0.8 + Math.random() * 0.6,
            duration: 2 + Math.random() * 3, repeat: -1, yoyo: true, ease: 'sine.inOut', delay: Math.random() * 2,
          });
        });

        const navbar = document.querySelector('header');
        if (navbar) {
          ScrollTrigger.create({ start: 'top -80', onEnter: () => navbar.classList.add('scrolled'), onLeaveBack: () => navbar.classList.remove('scrolled') });
        }

        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
          anchor.addEventListener('click', (e) => {
            e.preventDefault();
            const href = (anchor as HTMLAnchorElement).getAttribute('href');
            if (href) { const target = document.querySelector(href); if (target) lenis.scrollTo(target, { offset: -80 }); }
          });
        });
      }
    </script>
  </body>
</html>
