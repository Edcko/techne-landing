---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
}

const { title = 'Techne — Masterful craft. Infinite solutions.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Techne — Software development studio. Web, mobile, automation, SaaS. Masterful craft. Infinite solutions." />
    <meta name="theme-color" content="#0B0D17" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-obsidian text-marble font-body antialiased">
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      // Lenis smooth scroll
      import Lenis from 'lenis';

      const lenis = new Lenis({
        duration: 1.2,
        easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        smoothWheel: true,
      });

      function raf(time: number) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }
      requestAnimationFrame(raf);

      // GSAP ScrollTrigger animations
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      // Animate sections on scroll
      const sections = document.querySelectorAll('[data-animate]');
      sections.forEach((section) => {
        const children = section.querySelectorAll('[data-reveal]');
        gsap.fromTo(children,
          { opacity: 0, y: 40 },
          {
            opacity: 1,
            y: 0,
            duration: 0.8,
            stagger: 0.15,
            ease: 'power3.out',
            scrollTrigger: {
              trigger: section,
              start: 'top 80%',
              toggleActions: 'play none none none',
            },
          }
        );
      });

      // Parallax on hero eclipse
      const heroEclipse = document.querySelector('#hero-eclipse');
      if (heroEclipse) {
        gsap.to(heroEclipse, {
          y: 80,
          scale: 1.05,
          opacity: 0.6,
          scrollTrigger: {
            trigger: '#hero',
            start: 'top top',
            end: 'bottom top',
            scrub: 1,
          },
        });
      }

      // Constellation nodes animation
      const nodes = document.querySelectorAll('.constellation-node');
      nodes.forEach((node, i) => {
        gsap.to(node, {
          opacity: 0.3 + Math.random() * 0.5,
          scale: 0.8 + Math.random() * 0.6,
          duration: 2 + Math.random() * 3,
          repeat: -1,
          yoyo: true,
          ease: 'sine.inOut',
          delay: Math.random() * 2,
        });
      });
    </script>
  </body>
</html>
